// content_type: comment | rating | resource | avatar | bio
// status: pending | approved | rejected | manual
model moderation_task {
  id            Int       @id @default(autoincrement())
  content_type  String    @db.VarChar(107)
  // primary key of the content row; null for avatar/bio (located by user_id)
  content_id    Int?
  // snapshot of the text under review, or staged values for avatar/bio
  payload       Json
  status        String    @default("pending") @db.VarChar(107)
  reject_code   String    @default("") @db.VarChar(107)
  reject_reason String    @default("") @db.VarChar(1007)
  // raw AI verdict for tuning and auditing
  verdict       Json?
  model         String    @default("") @db.VarChar(233)
  tokens_in     Int       @default(0)
  tokens_out    Int       @default(0)
  retry         Int       @default(0)
  next_attempt  DateTime  @default(now())
  // 认领租约: worker 处理前置为当前时间, 使锁失效/第二个 worker 抢不到同一行, 避免
  // 重复调用 AI; 过期 (崩溃 worker 遗留) 的租约可被回收. null = 未认领
  picked_at     DateTime?
  // dry run: verdict recorded but never applied, content stays public
  dry_run       Boolean   @default(false)
  reviewed      DateTime?

  user_id Int
  user    user @relation("user_moderation_task", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  appeal moderation_appeal? @relation("moderation_task_appeal")

  created DateTime @default(now())
  updated DateTime @updatedAt

  @@index([status, next_attempt])
  @@index([content_type, content_id])
  @@index([user_id, created(sort: Desc)])
  @@index([created])
}

// 用户对被拒审核裁决的申诉, 由管理员人工复核
// content_type: comment | rating | resource (avatar/bio 被拒时未隐藏, 不适用申诉)
// status: pending | approved | rejected
model moderation_appeal {
  id           Int    @id @default(autoincrement())
  content_type String @db.VarChar(107)
  content_id   Int
  // 用户修改后待人工复核的内容: comment/rating 为 { text }, resource 为 { name, note }
  payload      Json
  status       String @default("pending") @db.VarChar(107)
  // 处理该申诉的管理员 uid
  handled_by   Int?

  // 被申诉的 rejected 任务; rejected 任务除用户级联外不会被删除, 严格外键安全
  task_id Int             @unique
  task    moderation_task @relation("moderation_task_appeal", fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  user_id Int
  user    user @relation("user_moderation_appeal", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  created DateTime @default(now())
  updated DateTime @updatedAt

  @@index([status, created(sort: Desc)])
  @@index([content_type, content_id])
  @@index([user_id, created(sort: Desc)])
}

model moderation_blacklist {
  id      Int    @id @default(autoincrement())
  // case-insensitive substring matched against normalized text
  pattern String @db.VarChar(1007)

  user_id Int
  user    user @relation("user_moderation_blacklist", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  created DateTime @default(now())
  updated DateTime @updatedAt
}
